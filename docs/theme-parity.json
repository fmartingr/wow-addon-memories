{
  "about": "Maps each component of the website theme to the app theme. scripts/theme-parity.mjs checks it. Each value has a css form (found as a whole word in the CSS rule) and a dart form (found in the Dart file, inside `dart.scope` when it is given). Each class that web/base.css styles must be in `components` (its selector or `alsoCovers`) or in `webOnly`, so a new shared component is never forgotten in the app. Components of web/style.css are listed by hand.",
  "components": [
    {
      "name": "panel",
      "css": {
        "file": "web/base.css",
        "selector": ".panel {"
      },
      "dart": {
        "file": "app/lib/src/theme/ak_theme.dart",
        "symbol": "AkPanelBorder",
        "use": "CardThemeData, DialogThemeData",
        "scope": [
          "// The literals of `.panel`",
          "TextStyle _display("
        ]
      },
      "values": [
