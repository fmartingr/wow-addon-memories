# Copy this file to .env. The server reads every MEMORIES_* variable here; Caddy reads MEMORIES_DOMAIN.
# docs/self-host.md lists all variables and their defaults.

# The domain that points to this host. Caddy gets the HTTPS certificate for it. Use localhost to try the setup.
MEMORIES_DOMAIN=wowjourney.xyz

# The public address of the site, with no path. It must match the domain above.
MEMORIES_SITE_URL=https://wowjourney.xyz
MEMORIES_SITE_NAME=WoW Journey

# The repository that the home page links to. Change it if your repository has another address.
MEMORIES_GITHUB_URL=https://github.com/fmartingr/wow-addon-memories
MEMORIES_CURSEFORGE_URL=https://www.curseforge.com/wow/addons/memories
MEMORIES_EXAMPLE_URL=https://wowjourney.xyz/forever/eu/brumamar/neral

# invite: a player needs an invite code from the admin page. open: any player can register.
# This is the value on the first start only. After that, the Settings page of the admin page changes it.
MEMORIES_REGISTRATION=invite

# Optional: send the server errors and panics to Sentry. Leave the DSN empty to turn Sentry off.
MEMORIES_SENTRY_DSN=
MEMORIES_SENTRY_ENVIRONMENT=production

# The image tag to run: latest (newest release), edge (newest main) or a release such as v1.2.3.
MEMORIES_IMAGE_TAG=latest
