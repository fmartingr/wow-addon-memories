package-as: Memories
manual-changelog:
  filename: RELEASE_NOTES.md
  markup-type: markdown
optional-dependencies:
  - paparazzi
move-folders:
  Memories/addons/Memories: Memories
  Memories/addons/Memories_Character: Memories_Character
  Memories/addons/Memories_Combat: Memories_Combat
  Memories/addons/Memories_Economy: Memories_Economy
  Memories/addons/Memories_Gathering: Memories_Gathering
  Memories/addons/Memories_Social: Memories_Social
ignore:
  - .busted
  - .curse
  - .claude
  - .dockerignore
  - .fvmrc
  - .github
  - .luacheckrc
  - .luacov
  - .stylua.toml
  - .styluaignore
  - CHANGELOG.md
  - LICENSE
  - Makefile
  - README.md
  - RELEASE_NOTES.md
  - app
  - assets
  - deploy
  - docs
  - packages
  - scripts
  - server
  - spec
  - specs
  - testdata
  - web
